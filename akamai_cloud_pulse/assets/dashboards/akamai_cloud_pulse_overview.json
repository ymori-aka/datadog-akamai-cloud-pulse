{
  "title": "Akamai Cloud Pulse - Overview",
  "description": "Managed Database, NodeBalancer, Object Storage, LKE Enterprise, and Log Delivery metrics collected from Akamai Cloud Pulse.",
  "widgets": [
    {
      "id": 3,
      "definition": {
        "title": "About Akamai Cloud Pulse",
        "background_color": "vivid_blue",
        "show_title": true,
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "id": 1,
            "definition": {
              "type": "note",
              "content": "This dashboard shows [Akamai Cloud Pulse](https://techdocs.akamai.com/cloud-computing/docs/akamai-cloud-pulse) metrics for Managed Databases, NodeBalancers, Object Storage, LKE Enterprise clusters, and log delivery streams on Akamai Cloud.\n\nValues are the most recent complete Cloud Pulse bucket (1 minute for databases and most Object Storage metrics, 5 minutes for NodeBalancers, 1 hour for Object Storage content), so they trail real time by up to one bucket.\n\nUse the template variables to filter by region, entity label, LKE cluster, or bucket.",
              "background_color": "white",
              "font_size": "14",
              "text_align": "left",
              "vertical_align": "top",
              "show_tick": false,
              "tick_pos": "50%",
              "tick_edge": "left",
              "has_padding": true
            },
            "layout": {
              "x": 0,
              "y": 0,
              "width": 7,
              "height": 3
            }
          },
          {
            "id": 2,
            "definition": {
              "title": "Collection status",
              "title_size": "16",
              "title_align": "left",
              "type": "check_status",
              "check": "akamai_cloud_pulse.can_connect",
              "grouping": "cluster",
              "group_by": [
                "service_type"
              ],
              "tags": []
            },
            "layout": {
              "x": 7,
              "y": 0,
              "width": 5,
              "height": 3
            }
          }
        ]
      },
      "layout": {
        "x": 0,
        "y": 0,
        "width": 12,
        "height": 4
      }
    },
